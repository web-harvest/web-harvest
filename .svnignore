# SVN Ignore file for Web-Harvest project
# Temporary and generated files that should not be committed to repository

# ========================================
# Maven Build Output
# ========================================
target/
*.class

# ========================================
# Test Output Files (should go to target/)
# ========================================
# Text outputs
*.txt
!README.txt

# XML/JSON/CSV outputs
*.xml.out
*.json.out
*.csv.out
*.html.out

# Test temporary directories
tmp/
var/
test-output/

# Debug files from tests
*debug_xmlData*
debug_*

# ========================================
# IDE Configuration Files
# ========================================
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse
.settings/
.project
.classpath
.metadata/

# NetBeans
nbproject/
nb-configuration.xml

# VS Code
.vscode/

# ========================================
# OS Files
# ========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ========================================
# Logs and Temporary Files
# ========================================
*.log
*.tmp
*.swp
*.swo
*.bak
*.orig

# ========================================
# Package Managers
# ========================================
node_modules/
bower_components/

# ========================================
# Generated Documentation
# ========================================
apidocs/
site/

# ========================================
# Temporary Development Files
# ========================================
classpath.txt
dependency-tree.txt
*.patch
*.diff

# ========================================
# Test-specific ignores
# ========================================
# Database test outputs
*.db
*.sqlite

# Downloaded files from tests
downloaded_*
upload_*

# Screenshot outputs
screenshot_*
*.png.tmp

# ========================================
# Module-specific
# ========================================
# CLI test outputs
webharvest-cli/test_outputs/

# Core test outputs  
webharvest-core/tmp/
webharvest-core/var/
webharvest-core/*.txt
webharvest-core/*.xml.out

# Database test outputs
webharvest-database/*.txt
webharvest-database/testdb/

# WebBrowser test outputs
webharvest-webbrowser/*.html.tmp
webharvest-webbrowser/screenshots/
