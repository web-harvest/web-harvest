<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <!--
        XPath Plugin Coverage Tests
        PURPOSE: Increase XPathPlugin coverage from 27% to 50%+
        COVERS: doExecute() method, error handling, edge cases
    -->
    
    <!-- Test 1: Simple XPath expression -->
    <def var="xml1">
        <constant><![CDATA[
            <books>
                <book id="1"><title>XPath Guide</title><author>John</author></book>
                <book id="2"><title>XML Basics</title><author>Jane</author></book>
            </books>
        ]]></constant>
    </def>
    
    <def var="titles">
        <xpath expression="//title">
            <var name="xml1"/>
        </xpath>
    </def>
    
    <!-- Test 2: XPath with attributes -->
    <def var="bookIds">
        <xpath expression="//book/@id">
            <var name="xml1"/>
        </xpath>
    </def>
    
    <!-- Test 3: XPath returning single node -->
    <def var="firstTitle">
        <xpath expression="//book[1]/title/text()">
            <var name="xml1"/>
        </xpath>
    </def>
    
    <!-- Test 4: XPath with predicates -->
    <def var="secondBook">
        <xpath expression="//book[@id='2']">
            <var name="xml1"/>
        </xpath>
    </def>
    
    <!-- Test 5: Empty result XPath -->
    <def var="nothing">
        <xpath expression="//nonexistent">
            <var name="xml1"/>
        </xpath>
    </def>
    
    <!-- Test 6: Complex XPath with contains() -->
    <def var="xpathSearch">
        <xpath expression="//book[contains(title, 'XPath')]">
            <var name="xml1"/>
        </xpath>
    </def>
    
    <!-- Test 7: XPath with count() function -->
    <def var="bookCount">
        <xpath expression="count(//book)">
            <var name="xml1"/>
        </xpath>
    </def>
    
    <!-- Test 8: XPath on HTML (after html-to-xml) -->
    <def var="htmlContent">
        <constant><![CDATA[
            <html>
                <body>
                    <div class="content">
                        <h1>Test Page</h1>
                        <p>Paragraph 1</p>
                        <p>Paragraph 2</p>
                    </div>
                </body>
            </html>
        ]]></constant>
    </def>
    
    <def var="paragraphs">
        <xpath expression="//p">
            <var name="htmlContent"/>
        </xpath>
    </def>
    
    <!-- Test 9: Nested XPath - extract then process -->
    <def var="h1Text">
        <xpath expression="//h1/text()">
            <var name="htmlContent"/>
        </xpath>
    </def>
    
    <!-- Test 10: XPath with multiple results -->
    <def var="allText">
        <xpath expression="//p/text()">
            <var name="htmlContent"/>
        </xpath>
    </def>
    
    <!-- Write results to file for verification -->
    <file action="write" path="target/test-output/xpath_coverage_output.txt">
        <template>
XPath Coverage Test Results:

Test 1 - Titles: ${titles}
Test 2 - IDs: ${bookIds}
Test 3 - First Title: ${firstTitle}
Test 4 - Second Book: ${secondBook}
Test 5 - Nothing: ${nothing}
Test 6 - Search: ${xpathSearch}
Test 7 - Count: ${bookCount}
Test 8 - Paragraphs: ${paragraphs}
Test 9 - H1 Text: ${h1Text}
Test 10 - All Text: ${allText}

All XPath operations completed successfully!
        </template>
    </file>
</config>

