<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <!-- Bug #62 verification: sequential regexp executions must isolate group variables -->

    <!-- Collected results -->
    <def var="results"></def>

    <!-- Pair 0 -->
    <def var="pair0">
        <regexp replace="false">
            <regexp-pattern>([^:]+):([^:]+)</regexp-pattern>
            <regexp-source>name:John</regexp-source>
            <regexp-result>
                <text>Pair 0: Key=${group1}, Value=${group2}
</text>
            </regexp-result>
        </regexp>
    </def>
    <def var="results">
        <get var="results"/>
        <get var="pair0"/>
    </def>

    <!-- Pair 1 -->
    <def var="pair1">
        <regexp replace="false">
            <regexp-pattern>([^:]+):([^:]+)</regexp-pattern>
            <regexp-source>age:30</regexp-source>
            <regexp-result>
                <text>Pair 1: Key=${group1}, Value=${group2}
</text>
            </regexp-result>
        </regexp>
    </def>
    <def var="results">
        <get var="results"/>
        <get var="pair1"/>
    </def>

    <!-- Pair 2 -->
    <def var="pair2">
        <regexp replace="false">
            <regexp-pattern>([^:]+):([^:]+)</regexp-pattern>
            <regexp-source>city:NYC</regexp-source>
            <regexp-result>
                <text>Pair 2: Key=${group1}, Value=${group2}
</text>
            </regexp-result>
        </regexp>
    </def>
    <def var="results">
        <get var="results"/>
        <get var="pair2"/>
    </def>

    <!-- Output results -->
    <file action="write" path="bug62_output.txt">
        <get var="results"/>
    </file>
</config>

