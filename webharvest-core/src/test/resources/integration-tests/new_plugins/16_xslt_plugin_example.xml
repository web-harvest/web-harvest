<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <!-- Test XSLT transformation -->
    <def var="xmlData">&lt;root&gt;&lt;item&gt;Test Item&lt;/item&gt;&lt;/root&gt;</def>
    <def var="xslStylesheet">&lt;xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"&gt;&lt;xsl:template match="/"&gt;&lt;result&gt;&lt;xsl:value-of select="//item"/&gt;&lt;/result&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</def>
    
    <file action="write" path="target/test-output/xslt_output.xml">
        <xslt>
            <stylesheet>
                <get var="xslStylesheet"/>
            </stylesheet>
            <xml>
                <get var="xmlData"/>
            </xml>
        </xslt>
    </file>
</config>


