<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
  <def var="value" value="2"/>
  <case>
    <if condition="${value == 1}">
      <template>Case 1</template>
    </if>
    <if condition="${value == 2}">
      <template>Case 2</template>
    </if>
    <if condition="${value == 3}">
      <template>Case 3</template>
    </if>
    <else>
      <template>Default case</template>
    </else>
  </case>
  <file path="target/test-output/case_output.txt" action="write">
        Case plugin executed successfully. Value was: ${value}
    </file>
</config>