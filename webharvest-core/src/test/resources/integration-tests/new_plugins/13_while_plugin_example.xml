<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <def var="counter">0</def>
    <file action="write" path="target/test-output/while_output.txt">
        <while test="${counter} &lt; 3">
            <template>Counter: ${counter}</template>
            <def var="counter">${counter + 1}</def>
        </while>
    </file>
</config>




