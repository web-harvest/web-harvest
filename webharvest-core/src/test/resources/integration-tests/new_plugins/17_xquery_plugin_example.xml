<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <def var="xmlData">&lt;root&gt;&lt;item&gt;Test Item&lt;/item&gt;&lt;item&gt;Another Item&lt;/item&gt;&lt;/root&gt;</def>
    <file action="write" path="xquery_output.xml">
        <xquery>
            <xq-expression><![CDATA[
                for $item in $input/root/item
                return <result>{$item/text()}</result>
            ]]></xq-expression>
            <xq-param name="input" type="node()">
                <get var="xmlData"/>
            </xq-param>
        </xquery>
    </file>
</config>
