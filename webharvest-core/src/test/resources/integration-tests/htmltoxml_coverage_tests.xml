<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <!--
        HtmlToXml Plugin Coverage Tests
        PURPOSE: Increase HtmlToXmlPlugin coverage from 9% to 50%+
        COVERS: HTML parsing, various options, edge cases
    -->
    
    <!-- Test 1: Basic HTML to XML conversion -->
    <def var="simpleHtml">
        <constant><![CDATA[
            <html><body><h1>Title</h1><p>Content</p></body></html>
        ]]></constant>
    </def>
    
    <def var="simpleXml">
        <html-to-xml>
            <var name="simpleHtml"/>
        </html-to-xml>
    </def>
    
    <!-- Test 2: HTML with special characters -->
    <def var="specialCharsHtml">
        <constant><![CDATA[
            <div>Special: &amp; &lt; &gt; &quot; &#39;</div>
        ]]></constant>
    </def>
    
    <def var="specialXml">
        <html-to-xml advancedxmlescape="true">
            <var name="specialCharsHtml"/>
        </html-to-xml>
    </def>
    
    <!-- Test 3: HTML with Unicode characters -->
    <def var="unicodeHtml">
        <constant><![CDATA[
            <p>Unicode: ąćęłńóśźż 中文 Русский émañá</p>
        ]]></constant>
    </def>
    
    <def var="unicodeXml">
        <html-to-xml unicodechars="true">
            <var name="unicodeHtml"/>
        </html-to-xml>
    </def>
    
    <!-- Test 4: HTML with comments -->
    <def var="commentsHtml">
        <constant><![CDATA[
            <!-- Comment 1 -->
            <div>Content</div>
            <!-- Comment 2 -->
        ]]></constant>
    </def>
    
    <def var="withComments">
        <html-to-xml omitcomments="false">
            <var name="commentsHtml"/>
        </html-to-xml>
    </def>
    
    <def var="withoutComments">
        <html-to-xml omitcomments="true">
            <var name="commentsHtml"/>
        </html-to-xml>
    </def>
    
    <!-- Test 5: Malformed HTML (unclosed tags) -->
    <def var="malformedHtml">
        <constant><![CDATA[
            <div><p>Paragraph 1<p>Paragraph 2</div>
        ]]></constant>
    </def>
    
    <def var="cleanedXml">
        <html-to-xml>
            <var name="malformedHtml"/>
        </html-to-xml>
    </def>
    
    <!-- Test 6: HTML with unknown/custom tags -->
    <def var="customTagsHtml">
        <constant><![CDATA[
            <customtag>Content</customtag>
            <anothertag attr="value">More</anothertag>
        ]]></constant>
    </def>
    
    <def var="customXml">
        <html-to-xml omitunknowntags="false" treatunknowntagsascontent="false">
            <var name="customTagsHtml"/>
        </html-to-xml>
    </def>
    
    <!-- Test 7: Empty HTML -->
    <def var="emptyHtml">
        <constant></constant>
    </def>
    
    <def var="emptyXml">
        <html-to-xml>
            <var name="emptyHtml"/>
        </html-to-xml>
    </def>
    
    <!-- Test 8: HTML with attributes -->
    <def var="attrsHtml">
        <constant><![CDATA[
            <div id="main" class="container" data-value="test">
                <a href="http://example.com" target="_blank">Link</a>
            </div>
        ]]></constant>
    </def>
    
    <def var="attrsXml">
        <html-to-xml allowmultiwordattributes="true">
            <var name="attrsHtml"/>
        </html-to-xml>
    </def>
    
    <!-- Test 9: HTML with deprecated tags -->
    <def var="deprecatedHtml">
        <constant><![CDATA[
            <center>Centered</center>
            <font color="red">Red text</font>
        ]]></constant>
    </def>
    
    <def var="deprecatedXml">
        <html-to-xml omitdeprtags="false" treatdeprtagsascontent="false">
            <var name="deprecatedHtml"/>
        </html-to-xml>
    </def>
    
    <!-- Test 10: Complex real-world HTML -->
    <def var="realHtml">
        <constant><![CDATA[
            <!DOCTYPE html>
            <html lang="en">
            <head><title>Test Page</title></head>
            <body>
                <div class="header">
                    <h1>Main Title</h1>
                    <nav><a href="/">Home</a><a href="/about">About</a></nav>
                </div>
                <div class="content">
                    <article>
                        <h2>Article Title</h2>
                        <p>First paragraph with <strong>bold</strong> text.</p>
                        <p>Second paragraph with <em>italic</em> text.</p>
                    </article>
                </div>
            </body>
            </html>
        ]]></constant>
    </def>
    
    <def var="realXml">
        <html-to-xml 
            advancedxmlescape="true" 
            specialentities="true" 
            unicodechars="true"
            omitcomments="true">
            <var name="realHtml"/>
        </html-to-xml>
    </def>
    
    <!-- Write results -->
    <file action="write" path="target/test-output/htmltoxml_coverage_output.txt">
        <template>
HtmlToXml Coverage Test Results:

Test 1 - Simple: ${simpleXml}
Test 2 - Special chars: ${specialXml}
Test 3 - Unicode: ${unicodeXml}
Test 4a - With comments: ${withComments}
Test 4b - Without comments: ${withoutComments}
Test 5 - Malformed: ${cleanedXml}
Test 6 - Custom tags: ${customXml}
Test 7 - Empty: ${emptyXml}
Test 8 - Attributes: ${attrsXml}
Test 9 - Deprecated tags: ${deprecatedXml}
Test 10 - Real HTML: ${realXml}

All HtmlToXml operations completed successfully!
        </template>
    </file>
</config>

