<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <!-- Bug #16: <try> cannot catch exception raised by invalid URI in <http> -->
    
    <!-- Test with severely malformed URI that definitely throws IllegalArgumentException -->
    <!-- NOTE: <try> and <catch> are SIBLINGS, not parent-child! -->
    <try>
        <!-- Space in URL - should throw IllegalArgumentException from GetMethod -->
        <http url="http://example.com/path with spaces" />
    </try>
    <catch>
        <!-- Should execute when exception is caught by preceding <try> -->
        <file action="write" path="target/test-output/bug16_caught.txt">
            Exception caught: ${error}
            Error type: ${errorType}
        </file>
    </catch>
    
    <!-- If we reach here, the exception was properly caught -->
    <file action="write" path="target/test-output/bug16_success.txt">
        Test completed successfully - exception was caught by try/catch
    </file>
</config>

