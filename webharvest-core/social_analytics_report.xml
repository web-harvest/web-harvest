<social_media_analytics>
                <hashtag>${hashtag}</hashtag>
                <analysis_date>${sys.datetime("yyyy-MM-dd HH:mm:ss")}</analysis_date>
                <sentiment_analysis>
                    <script>sentimentAnalysis</script>
                </sentiment_analysis>
                <engagement_metrics>
                    <script>engagementMetrics</script>
                </engagement_metrics>
                <top_posts>
                    <loop item="post" index="i">
                        <list>
                            <xpath expression="//item[position() <= 3]">
                                <script>postsXml</script>
                            </xpath>
                        </list>
                    </loop>
                </top_posts>
            </social_media_analytics>