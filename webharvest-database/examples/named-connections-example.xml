<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional Database module example.
  Both <connection> and <database> use the Core namespace.
  This example demonstrates named connections and inline connection mode.
-->
<config xmlns="http://org.webharvest/schema/2.1/core">
  <connection id="mainDB"
              driver="org.postgresql.Driver"
              url="jdbc:postgresql://localhost:5432/production"
              username="prod_user"
              password="replace-me"/>

  <database connection="mainDB" sql="SELECT id, name FROM users WHERE active = true"/>

  <database driver="org.h2.Driver"
            url="jdbc:h2:mem:scratch"
            username="sa"
            password=""
            sql="SELECT 1 AS result"/>
</config>
