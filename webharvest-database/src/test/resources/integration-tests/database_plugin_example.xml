<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
  <!-- Test Database plugin -->
  <def var="dbUrl">jdbc:h2:mem:testdb</def>
  <def var="dbDriver">org.h2.Driver</def>
  <database url="${dbUrl}" driver="${dbDriver}">
    <!-- Create test table -->
    <template>CREATE TABLE IF NOT EXISTS test_table (id INT, name VARCHAR(50))</template>
    <!-- Insert test data -->
    <template>INSERT INTO test_table (id, name) VALUES (1, 'Test User')</template>
    <!-- Select data -->
    <template>SELECT * FROM test_table WHERE id = 1</template>
  </database>
  <file action="write" path="target/test-output/database_output.txt">
    <template>Database operations completed successfully</template>
  </file>
  <config>
    <template>Database plugin test completed</template>
  </config>
</config>
