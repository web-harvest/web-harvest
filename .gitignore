# WebHarvest .gitignore
# Based on .svnignore + Maven/Java best practices

# ============================================
# From .svnignore (SVN legacy)
# ============================================
# Test output files - should be in target/test-output/
*_output.txt
*_output.xml
*_output.json
test_results*.log

# ============================================
# Maven
# ============================================
target/
target*/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ============================================
# Java
# ============================================
*.class
*.jar
!**/src/test/resources/**/*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Package Files
*.jar
*.war
*.nar
*.ear
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# ============================================
# IDE - IntelliJ IDEA
# ============================================
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# ============================================
# IDE - Eclipse
# ============================================
.classpath
.project
.settings/
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.loadpath
.recommenders

# ============================================
# IDE - NetBeans
# ============================================
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ============================================
# IDE - VS Code
# ============================================
.vscode/
*.code-workspace
.history/

# ============================================
# OS Generated Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================
# Logs
# ============================================
*.log
log/
logs/

# ============================================
# Build and Test Output
# ============================================
var/
build/
test-output/
*.exec

# JaCoCo coverage reports
*.exec
jacoco.exec

# ============================================
# WebHarvest Specific
# ============================================
# Temporary scraping data
temp/
downloads/
cache/

# Local configuration overrides
local-config.xml
webharvest-local.properties

# ============================================
# Security - Never commit sensitive data
# ============================================
secrets.properties
credentials.properties
*.key
*.pem
*.p12
*.pfx

# ============================================
# Node.js (for frontend/docs)
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ============================================
# Python (for doc generation scripts)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# ============================================
# Backup and Temporary Files
# ============================================
*.bak
*.tmp
*.temp
*~
.#*
\#*#

# ============================================
# SVN (legacy - keeping for reference)
# ============================================
.svn/


# Generated test output files in webharvest-core (from example XML configurations)
/webharvest-core/*.html
/webharvest-core/*.xml
/webharvest-core/*.txt
/webharvest-core/*.csv
!/webharvest-core/pom.xml
!/webharvest-core/src/

# Generated test output directories in webharvest-core
/webharvest-core/canon/
/webharvest-core/expekt/
/webharvest-core/product_catalog/
/webharvest-core/scripts/
/webharvest-core/flickr/
/webharvest-core/google_images/
/webharvest-core/nytimes/
/webharvest-core/spider/
