<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <!-- The zip processor returns binary data; capture it in a variable. -->
    <def var="archive">
        <zip>
            <zip-entry name="before.txt">
                <template><![CDATA[before]]></template>
            </zip-entry>
            <zip-entry name="inner.zip">
                <zip>
                    <zip-entry name="inner.txt">
                        <template><![CDATA[inside]]></template>
                    </zip-entry>
                </zip>
            </zip-entry>
            <zip-entry name="after.txt">
                <template><![CDATA[after]]></template>
            </zip-entry>
            <zip-entry name="latin1.txt" charset="ISO-8859-1">
                <template><![CDATA[café]]></template>
            </zip-entry>
        </zip>
    </def>
</config>
