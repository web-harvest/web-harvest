<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <!-- Example 1: Easy SSL mode - accepts self-signed certificates -->
    <http url="https://self-signed.example.com/api/data" 
          ssl-mode="easy" 
          ssl-protocol="TLSv1.2"
          verify-hostname="false"
          allow-self-signed="true">
        <http-header name="Accept" value="application/json"/>
    </http>
    <!-- Example 2: Strict SSL mode - only trusted certificates -->
    <http url="https://trusted.example.com/api/data" 
          ssl-mode="strict" 
          ssl-protocol="TLSv1.3"
          verify-hostname="true">
        <http-header name="Authorization" value="Bearer ${token}"/>
    </http>
    <!-- Example 3: Custom SSL mode with keystore and truststore -->
    <http url="https://custom.example.com/api/data" 
          ssl-mode="custom" 
          ssl-protocol="TLSv1.2"
          keystore-path="classpath:client-keystore.jks"
          keystore-password="clientpassword"
          keystore-type="JKS"
          truststore-path="classpath:client-truststore.jks"
          truststore-password="trustpassword"
          truststore-type="JKS"
          verify-hostname="true">
        <http-header name="Content-Type" value="application/json"/>
    </http>
    <!-- Example 4: Disabled SSL mode -->
    <http url="http://insecure.example.com/api/data" 
          ssl-mode="disabled">
        <http-header name="Accept" value="text/plain"/>
    </http>
    <!-- Example 5: Easy SSL with additional security settings -->
    <http url="https://test.example.com/api/data" 
          ssl-mode="easy" 
          ssl-protocol="TLSv1.2"
          verify-hostname="false"
          allow-self-signed="true"
          allow-expired="false"
          allow-invalid-hostname="true">
        <http-header name="User-Agent" value="Web-Harvest/2.1.0"/>
    </http>
    <!-- Example 6: POST request with SSL configuration -->
    <http url="https://api.example.com/submit" 
          method="post"
          ssl-mode="easy"
          ssl-protocol="TLSv1.2"
          verify-hostname="false"
          allow-self-signed="true"
          content-type="application/json">
        <http-header name="Content-Type" value="application/json"/>
        <http-header name="Accept" value="application/json"/>
        <http-param name="data" value='{"name": "test", "value": "example"}'/>
    </http>
    <!-- Example 7: SSL configuration with retry settings -->
    <http url="https://unreliable.example.com/api/data" 
          ssl-mode="easy"
          ssl-protocol="TLSv1.2"
          verify-hostname="false"
          allow-self-signed="true"
          retry-attempts="3"
          retry-delay="5000"
          retry-delay-factor="2.0">
        <http-header name="Accept" value="application/json"/>
    </http>
    <!-- Example 8: SSL configuration with authentication -->
    <http url="https://secure.example.com/api/data" 
          ssl-mode="strict"
          ssl-protocol="TLSv1.3"
          verify-hostname="true"
          username="user"
          password="pass">
        <http-header name="Accept" value="application/json"/>
    </http>
</config>