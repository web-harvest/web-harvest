<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://web-harvest.sourceforge.net/schema/1.0/config" charset="UTF-8">
    <!-- Simple test example -->
    <var-def name="content">
        <html-to-xml>
            <http url="https://httpbin.org/html"/>
        </html-to-xml>
    </var-def>
    <!-- Extract title -->
    <var-def name="title">
        <xpath expression="//h1">
            <var name="content"/>
        </xpath>
    </var-def>
    <!-- Save result -->
    <file action="write" path="test_result.html" charset="UTF-8">
        <var name="content"/>
    </file>
    <!-- Print title -->
    <file action="write" path="title.txt" charset="UTF-8">
        <var name="title"/>
    </file>
</config>