<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
  <!-- Test WebBrowser plugin -->
  <def var="testUrl">https://httpbin.org/get</def>
  <web-browser url="${testUrl}" action="navigate">
    <!-- Navigate to URL -->
    <template>Navigate to ${testUrl}</template>
    <!-- Get page content -->
    <template>Get page content</template>
    <!-- Take screenshot -->
    <template>Take screenshot</template>
  </web-browser>
  <file action="write" path="webbrowser_output.txt">
    <template>WebBrowser operations completed successfully</template>
  </file>
  <config>
    <template>WebBrowser plugin test completed</template>
  </config>
</config>