<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <def var="textContent">Hello World! This is a test string.</def>
    <file action="write" path="tokenize_output.txt">
        <tokenize delimiter=" ">
            <get var="textContent"/>
        </tokenize>
    </file>
</config>




