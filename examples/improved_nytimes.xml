<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://web-harvest.sourceforge.net/schema/1.0/config">
    <!-- Improved New York Times scraper with better HTML handling -->
    <var-def name="startUrl">https://httpbin.org/html</var-def>
    
    <!-- Use improved html-to-xml for better HTML parsing -->
    <var-def name="pageContent">
        <html-to-xml 
            advancedxmlescape="true" 
            specialentities="true" 
            unicodechars="true" 
            allowmultiwordattributes="true" 
            omitunknowntags="true"
            treatunknowntagsascontent="true"
            omitdeprtags="true"
            treatdeprtagsascontent="true"
            omitcomments="true"
            omittermlenvelope="true">
            <http url="${startUrl}"/>
        </html-to-xml>
    </var-def>
    
    <!-- Extract content using XPath -->
    <var-def name="pageTitle">
        <xpath expression="//title">
            <script>pageContent</script>
        </xpath>
    </var-def>
    
    <var-def name="headings">
        <xpath expression="//h1 | //h2 | //h3 | //h4 | //h5 | //h6">
            <script>pageContent</script>
        </xpath>
    </var-def>
    
    <var-def name="paragraphs">
        <xpath expression="//p">
            <script>pageContent</script>
        </xpath>
    </var-def>
    
    <var-def name="links">
        <xpath expression="//a[@href]">
            <script>pageContent</script>
        </xpath>
    </var-def>
    
    <!-- Process the content -->
    <var-def name="processedContent">
        <template>
            <![CDATA[
            <news_article>
                <title>${pageTitle}</title>
                <extraction_date>${sys.datetime("yyyy-MM-dd HH:mm:ss")}</extraction_date>
                <headings>
                    <script>headings</script>
                </headings>
                <paragraphs>
                    <script>paragraphs</script>
                </paragraphs>
                <links>
                    <script>links</script>
                </links>
            </news_article>
            ]]>
        </template>
    </var-def>
    
    <!-- Save the processed content -->
    <file path="improved_news_article.xml" action="write">
        <script>processedContent</script>
    </file>
    
    <!-- Alternative approach using improved html-to-xml -->
    <var-def name="alternativeContent">
        <html-to-xml 
            advancedxmlescape="true" 
            specialentities="true" 
            unicodechars="true" 
            allowmultiwordattributes="true" 
            omitunknowntags="true"
            treatunknowntagsascontent="true"
            omitdeprtags="true"
            treatdeprtagsascontent="true"
            omitcomments="true"
            omittermlenvelope="true">
            <http url="${startUrl}"/>
        </html-to-xml>
    </var-def>
    
    <!-- Extract content using XPath -->
    <var-def name="extractedContent">
        <xpath expression="//body">
            <script>alternativeContent</script>
        </xpath>
    </var-def>
    
    <!-- Save alternative content -->
    <file path="alternative_content.xml" action="write">
        <template>
            <![CDATA[
            <alternative_extraction>
                <timestamp>${sys.datetime("yyyy-MM-dd HH:mm:ss")}</timestamp>
                <method>html-to-xml</method>
                <content>
                    <script>extractedContent</script>
                </content>
            </alternative_extraction>
            ]]>
        </template>
    </file>
    
    <!-- Generate comparison report -->
    <file path="extraction_comparison.xml" action="write">
        <template>
            <![CDATA[
            <extraction_comparison>
                <timestamp>${sys.datetime("yyyy-MM-dd HH:mm:ss")}</timestamp>
                <url>${startUrl}</url>
                <methods>
                    <method name="web-browser">
                        <description>Uses JavaScript to extract content</description>
                        <advantages>Handles JavaScript, better for modern sites</advantages>
                        <disadvantages>Slower, requires browser engine</disadvantages>
                    </method>
                    <method name="html-to-xml">
                        <description>Direct HTML to XML conversion</description>
                        <advantages>Faster, simpler</advantages>
                        <disadvantages>May struggle with malformed HTML</disadvantages>
                    </method>
                </methods>
                <recommendation>
                    Use web-browser for JavaScript-heavy sites, html-to-xml for simple HTML
                </recommendation>
            </extraction_comparison>
            ]]>
        </template>
    </file>
</config>
