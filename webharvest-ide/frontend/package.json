{
    "name": "webharvest-ide-frontend",
    "version": "2.2.0",
    "description": "WebHarvest IDE - TypeScript Frontend with Visual Designer",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "build:packages": "npm --prefix ../../packages/visual-shared/metadata-client run build && npm --prefix ../../packages/visual-shared/xml-roundtrip run build",
        "pretest": "npm run build:packages",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src --ext .ts,.tsx",
        "pretype-check": "npm run build:packages",
        "type-check": "tsc --noEmit",
        "prebuild": "npm run build:packages"
    },
    "dependencies": {
        "@types/d3": "^7.4.3",
        "@types/jointjs": "^1.0.5",
        "@webharvest/metadata-client": "file:../../packages/visual-shared/metadata-client",
        "@webharvest/xml-roundtrip": "file:../../packages/visual-shared/xml-roundtrip",
        "d3": "^7.9.0",
        "jointjs": "^3.7.7",
        "monaco-editor": "^0.44.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.8",
        "@types/node": "^20.9.0",
        "@types/node-fetch": "^2.6.13",
        "@typescript-eslint/eslint-plugin": "^6.11.0",
        "@typescript-eslint/parser": "^6.11.0",
        "eslint": "^8.54.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "node-fetch": "^2.7.0",
        "ts-jest": "^29.1.1",
        "typescript": "^5.3.2",
        "vite": "^5.0.0"
    }
}
