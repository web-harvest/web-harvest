{
    "name": "webharvest-ide-frontend",
    "version": "2.2.0",
    "description": "WebHarvest IDE - TypeScript Frontend with Visual Designer",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
