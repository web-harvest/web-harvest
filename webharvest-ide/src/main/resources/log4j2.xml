<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="WebHarvestIDE">
  <Appenders>
    <Console name="console" target="SYSTEM_OUT">
      <PatternLayout pattern="%-5p (%20F:%-3L) - %m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="debugFileLogger" level="ERROR" additivity="false"/>
    <Root level="INFO">
      <AppenderRef ref="console"/>
    </Root>
  </Loggers>
</Configuration>
