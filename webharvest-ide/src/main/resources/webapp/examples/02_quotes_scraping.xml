<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <!-- Scraping Quotes - quotes.toscrape.com (made for scrapers!) -->
    
    <def var="url">https://quotes.toscrape.com/</def>
    
    <!-- Download page -->
    <def var="html">
        <http url="${url}"/>
    </def>
    
    <!-- Parse to XML -->
    <def var="page">
        <html-to-xml>
            <get var="html"/>
        </html-to-xml>
    </def>
    
    <!-- Extract all quotes -->
    <def var="quotes">
        <xpath expression="//div[@class='quote']//span[@class='text']">
            <get var="page"/>
        </xpath>
    </def>
    
    <!-- Extract all authors -->
    <def var="authors">
        <xpath expression="//div[@class='quote']//small[@class='author']">
            <get var="page"/>
        </xpath>
    </def>
    
    <!-- Save results -->
    <file action="write" path="target/test-output/quotes.txt">
        <template>
=== QUOTES SCRAPED FROM ${url} ===

Quotes found:
${quotes}

Authors found:
${authors}

Total execution completed!
        </template>
    </file>
</config>

