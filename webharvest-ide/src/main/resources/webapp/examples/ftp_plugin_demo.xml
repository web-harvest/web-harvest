<?xml version="1.0" encoding="UTF-8"?>
<!--
    Simulated FTP workflow: we mock directory listings so the example
    remains compatible with the lightweight IDE runtime (no legacy ftp plugin).
-->
<config xmlns="http://org.webharvest/schema/2.1/core" charset="UTF-8">
    <def var="ftp_host">ftp.example.com</def>
    <def var="ftp_user">username</def>

    <def var="fileEntries">
        <list>
            <template>
                <![CDATA[<file_info name="readme.txt" size="4 KB" type="text" modified="${sys.datetime()}"/>]]>
            </template>
            <template>
                <![CDATA[<file_info name="orders.csv" size="21 KB" type="data" modified="${sys.datetime()}"/>]]>
            </template>
            <template>
                <![CDATA[<file_info name="reports/" size="-" type="directory" modified="${sys.datetime()}"/>]]>
            </template>
        </list>
    </def>

    <def var="downloadResult">
        <template><![CDATA[
        <download action="GET" remote="/data/sample.txt" local="downloaded_sample.txt" status="simulated"/>
        ]]></template>
    </def>

    <def var="uploadResult">
        <template><![CDATA[
        <upload action="PUT" local="upload_test.txt" remote="/uploads/test_${sys.datetime('yyyyMMdd_HHmmss')}.txt" status="simulated"/>
        ]]></template>
    </def>

    <file action="write" path="ftp_demo_results.xml" charset="UTF-8">
        <template><![CDATA[
        <ftp_demo_results generated="${sys.datetime()}">
            <server>${ftp_host}</server>
            <credentials user="${ftp_user}"/>
            <file_list>
        ]]></template>
        <loop item="entry">
            <list>
                <get var="fileEntries"/>
            </list>
            <template>${entry}</template>
        </loop>
        <template><![CDATA[
            </file_list>
            <operations>
                <get var="downloadResult"/>
                <get var="uploadResult"/>
            </operations>
        </ftp_demo_results>
        ]]></template>
    </file>

    <text>FTP demo completed (simulation). Results saved to ftp_demo_results.xml</text>
</config>












