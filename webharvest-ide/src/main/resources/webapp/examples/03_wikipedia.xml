<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core">
    <!-- Wikipedia Scraping (polite, with headers) -->
    
    <def var="topic">Web_scraping</def>
    <def var="url">https://en.wikipedia.org/wiki/${topic}</def>
    
    <!-- Download page -->
    <def var="html">
        <http url="${url}">
            <http-header name="User-Agent" value="Web-Harvest/2.2.0 (Educational)"/>
        </http>
    </def>
    
    <!-- Parse HTML -->
    <def var="page">
        <html-to-xml>
            <get var="html"/>
        </html-to-xml>
    </def>
    
    <!-- Extract title (use /text() to get text content) -->
    <def var="title">
        <xpath expression="//h1[@id='firstHeading']/text()">
            <get var="page"/>
        </xpath>
    </def>
    
    <!-- Extract first paragraph (use string() to get all text content) -->
    <def var="intro">
        <xpath expression="string(//div[@id='mw-content-text']//p[1])">
            <get var="page"/>
        </xpath>
    </def>
    
    <!-- Save results -->
    <file action="write" path="target/test-output/wikipedia_extract.txt">
        <template>
=== WIKIPEDIA ARTICLE: ${topic} ===

Title: ${title}

Introduction:
${intro}

Source: ${url}
        </template>
    </file>
</config>

