<?xml version="1.0" encoding="UTF-8"?>
<!--
    Modernized "database" example that simulates queries using core plugins only.
    We mock connection metadata and result-sets using JSON + json-to-xml so
    the configuration remains portable without legacy db plugins.
-->
<config xmlns="http://org.webharvest/schema/2.1/core">
    
    <!-- Simulated connection catalog -->
    <def var="connectionCatalog">
        <template><![CDATA[
        {
          "connections": [
            {"id":"mainDB","driver":"org.postgresql.Driver","url":"jdbc:postgresql://localhost:5432/production"},
            {"id":"analyticsDB","driver":"com.mysql.cj.jdbc.Driver","url":"jdbc:mysql://analytics:3306/analytics"},
            {"id":"scratchDB","driver":"org.h2.Driver","url":"jdbc:h2:mem:scratch"}
          ]
        }
        ]]></template>
    </def>
    
    <def var="connectionsXml">
        <json-to-xml tag="database_connections">
            <get var="connectionCatalog"/>
        </json-to-xml>
    </def>
    
    <file path="database/connections.xml" action="write">
        <get var="connectionsXml"/>
    </file>
    
    <!-- Simulated query payload -->
    <def var="queryResultJson">
        <template><![CDATA[
        {
          "rows": [
            {"id":1,"name":"Alice","email":"alice@example.com","active":true},
            {"id":2,"name":"Bob","email":"bob@example.com","active":true},
            {"id":3,"name":"Charlie","email":"charlie@example.com","active":false}
          ]
        }
        ]]></template>
    </def>
    
    <def var="queryResults">
        <json-to-xml tag="database_results">
            <get var="queryResultJson"/>
        </json-to-xml>
    </def>
    
    <!-- Basic analytics over the mocked result-set -->
    <def var="analyticsSummary">
        <xquery>
            <xq-param name="rows">
                <get var="queryResults"/>
            </xq-param>
            <xq-expression><![CDATA[
                declare variable $rows as node() external;
                let $total := count($rows//rows)
                let $active := count($rows//rows[active = "true"])
                return
                    <summary>
                        <total_users>{$total}</total_users>
                        <active_users>{$active}</active_users>
                        <inactive_users>{$total - $active}</inactive_users>
                    </summary>
            ]]></xq-expression>
        </xquery>
    </def>
    
    <file path="database/query_results.xml" action="write">
        <template><![CDATA[
        <database_report generated="${sys.datetime("yyyy-MM-dd'T'HH:mm:ss")}">
            <connections>
                <get var="connectionsXml"/>
            </connections>
            <result_set>
                <get var="queryResults"/>
            </result_set>
            <analytics>
                <get var="analyticsSummary"/>
            </analytics>
        </database_report>
        ]]></template>
    </file>
</config>

