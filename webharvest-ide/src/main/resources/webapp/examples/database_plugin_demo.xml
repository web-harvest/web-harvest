<?xml version="1.0" encoding="UTF-8"?>
<!--
    Lightweight database demo using JSON payloads instead of legacy db plugins.
    Shows how to normalize data, filter rows, and generate reports.
-->
<config xmlns="http://org.webharvest/schema/2.1/core" charset="UTF-8">
    <def var="productsJson">
        <template><![CDATA[
        {
          "products": [
            {"id":1,"name":"Web-Harvest Pro","price":299.99},
            {"id":2,"name":"Data Extractor","price":199.99},
            {"id":3,"name":"Scraper Suite","price":399.99},
            {"id":4,"name":"Reporting Add-on","price":149.00}
          ]
        }
        ]]></template>
    </def>

    <def var="productsXml">
        <json-to-xml tag="products">
            <get var="productsJson"/>
        </json-to-xml>
    </def>

    <!-- Filter products above configurable price -->
    <def var="minPrice">200</def>
    <def var="filteredProducts">
        <xquery>
            <xq-param name="rows">
                <get var="productsXml"/>
            </xq-param>
            <xq-param name="minPrice">
                <get var="minPrice"/>
            </xq-param>
            <xq-expression><![CDATA[
                declare variable $rows as node() external;
                declare variable $minPrice as xs:decimal external;
                <expensive_products>{
                    for $row in $rows//products return
                        if (xs:decimal($row/price) >= $minPrice) then
                            <product>
                                <id>{data($row/id)}</id>
                                <name>{data($row/name)}</name>
                                <price>{data($row/price)}</price>
                            </product>
                        else ()
                }</expensive_products>
            ]]></xq-expression>
        </xquery>
    </def>

    <!-- Aggregate metrics -->
    <def var="productSummary">
        <xquery>
            <xq-param name="rows">
                <get var="productsXml"/>
            </xq-param>
            <xq-expression><![CDATA[
                declare variable $rows as node() external;
                let $total := count($rows//products)
                let $avg := avg($rows//products/price)
                let $max := max($rows//products/price)
                return
                    <summary>
                        <total_products>{$total}</total_products>
                        <average_price>{round($avg)}</average_price>
                        <max_price>{$max}</max_price>
                    </summary>
            ]]></xq-expression>
        </xquery>
    </def>

    <file action="write" path="database_demo_results.xml" charset="UTF-8">
        <template><![CDATA[
        <database_demo generated="${sys.datetime("yyyy-MM-dd'T'HH:mm:ss")}">
            <all_products>
                <get var="productsXml"/>
            </all_products>
            <filtered_products>
                <get var="filteredProducts"/>
            </filtered_products>
            <metrics>
                <get var="productSummary"/>
            </metrics>
        </database_demo>
        ]]></template>
    </file>

    <text>Database demo completed. Results saved to database_demo_results.xml</text>
</config>












